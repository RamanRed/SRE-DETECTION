# ────────────────────────────────────────────────────────────────────────────
# SRE Incident Copilot Platform — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ────────────────────────────────────────────────────────────────────────────

# ── AI engine ─────────────────────────────────────────────────────────────
# Empty key = deterministic built-in heuristic mode. This is the default and
# lets `docker compose up --build` work without network access or credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=15s

# Groq is OpenAI-compatible. To use it, set your key and uncomment these:
# OPENAI_API_KEY=gsk_your_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai
# OPENAI_MODEL=llama-3.3-70b-versatile

# Optional local Ollama profile:
#   OPENAI_API_KEY=ollama OPENAI_BASE_URL=http://ollama:11434/v1 \
#   OPENAI_MODEL=qwen2.5-coder:1.5b docker compose --profile ollama up --build

# ── PostgreSQL Database ──
POSTGRES_DB=sredb
POSTGRES_USER=sreuser
POSTGRES_PASSWORD=srepassword
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sredb
DB_USERNAME=sreuser
DB_PASSWORD=srepassword
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ── Microservices Networking ──
AI_COPILOT_HOST=ai-copilot-service
AI_COPILOT_PORT=9090
INCIDENT_SERVICE_PORT=8081
FRONTEND_PORT=80
AI_RPC_TIMEOUT=25s

# Required only when saving GitHub/Jenkins integration tokens. Generate one
# 32-byte key (for example, `openssl rand -base64 32`), store it in your secret
# manager, and keep it stable so existing credentials remain decryptable.
INTEGRATION_ENCRYPTION_KEY=
REQUIRE_INTEGRATION_ENCRYPTION_KEY=false

# ── API security ──────────────────────────────────────────────────────────
# Local Compose defaults to explicit demo mode. For any shared or public
# deployment set DEMO_MODE=false and provide three different random secrets.
# AUTH_SESSION_SECRET must be at least 32 bytes and AUTH_BOOTSTRAP_PASSWORD at
# least 12 bytes. Replace the CORS list with the exact dashboard origin(s);
# secure mode deliberately rejects `*`.
DEMO_MODE=true
AUTH_SESSION_SECRET=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_ROLE=SRE_LEAD
AUTH_SESSION_TTL=8h
CI_WEBHOOK_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ── Autonomous integration worker ─────────────────────────────────────────
AUTOMATION_ENABLED=true
AUTOMATION_SWEEP_INTERVAL=30s
CI_STATUS_POLL_INTERVAL=10s
CI_BUILD_TIMEOUT=10m
# Keep false on developer machines unless connecting to a trusted private CI
# endpoint. K3s enables it deliberately for kubernetes.default.svc.
ALLOW_PRIVATE_INTEGRATION_ENDPOINTS=false
KUBERNETES_NAMESPACE=sre-copilot

# ── Go runtime/container memory guardrails ──
INCIDENT_GOMEMLIMIT=96MiB
AI_GOMEMLIMIT=96MiB
INCIDENT_MEMORY_LIMIT=128m
AI_MEMORY_LIMIT=128m
POSTGRES_MEMORY_LIMIT=256m
FRONTEND_MEMORY_LIMIT=128m
OLLAMA_MEMORY_LIMIT=3g

# ── Jenkins CI Integration (Optional) ──
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
# Load this from a secret manager when integration sync is enabled.
JENKINS_API_TOKEN=

# ── Cloud Deployment (Terraform / AWS) ──
AWS_REGION=eu-north-1
EC2_INSTANCE_TYPE=t3.small
